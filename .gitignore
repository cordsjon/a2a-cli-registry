.venv/
__pycache__/
*.db
# Anchor on the stem, not the extension: backup suffixes appended after ".db"
# (registry.db.bak-<sha>, registry.db.lock) slip past the *.db glob above.
registry.db*
.pytest_cache/
*.egg-info/
dist/
build/
*.pyc
HANDOVER-*.md
.superpowers/
# demo/ holds janitor-swept blobs (cli-audit/latest.json, proposals.json) BUT
# also config.toml, which the live service runs with (--config demo/config.toml)
# and which fleet-clis/*/seed/apply.sh default to. Exclude the contents, not the
# directory itself — git cannot re-include a file under an excluded directory.
demo/*
!demo/config.toml
.remediate-runs/
.codex-runs/
